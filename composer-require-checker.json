{
	"scan-files": [
		"index.php",
		"legacy.php",
		"autoload.php",
		"config/*.php",
		"src/*.php",
		"snippets/*/*.php"
	],
	"symbol-whitelist": [
		"Kirby",
		"Kirby\\Cms\\App",
		"Kirby\\Cms\\Helpers",
		"Kirby\\Cms\\Html",
		"Kirby\\Cms\\Page",
		"Kirby\\Filesystem\\F",
		"Kirby\\Http\\Response",
		"Kirby\\Text\\KirbyTag",
		"Sudare\\Sudare",
		"attr",
		"esc",
		"get",
		"kirby",
		"CURLINFO_RESPONSE_CODE",
		"CURLOPT_CONNECTTIMEOUT",
		"CURLOPT_FOLLOWLOCATION",
		"CURLOPT_MAXREDIRS",
		"CURLOPT_PROTOCOLS",
		"CURLOPT_REDIR_PROTOCOLS",
		"CURLOPT_TIMEOUT",
		"CURLOPT_USERAGENT",
		"CURLOPT_WRITEFUNCTION",
		"CURLPROTO_HTTPS",
		"curl_exec",
		"curl_getinfo",
		"curl_init",
		"curl_setopt_array"
