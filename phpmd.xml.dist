<?xml version="1.0"?>
<ruleset name="Shoji"
	xmlns="http://pmd.sf.net/ruleset/1.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
	xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
	<description>PHP Mess Detector rules for Shoji. Every exclusion and raised threshold has its reason here.</description>

	<rule ref="rulesets/cleancode.xml">
		<!-- Kirby's own helpers are static (Options, I18n, Providers): the static calls are the API. -->
		<exclude name="StaticAccess" />
		<!-- The assignment in a condition reads as "match, then use" in the lookups of Providers and Thumbs. -->
		<exclude name="IfStatementAssignment" />
		<!-- The cache and secret writes are best-effort: a failed write is detected by its return value and logged. -->
		<exclude name="ErrorControlOperator" />
	</rule>

	<!-- codesize: listed rule by rule, so the threshold below replaces the default. -->
	<rule ref="rulesets/codesize.xml/CyclomaticComplexity">
		<!-- Providers::problem() checks one rule per field on purpose (22); Providers::defaults() is the table of built-in providers (20). -->
		<properties>
			<property name="reportLevel" value="23" />
		</properties>
	</rule>
	<rule ref="rulesets/codesize.xml/ExcessiveMethodLength" />
	<rule ref="rulesets/codesize.xml/ExcessiveClassLength" />
	<rule ref="rulesets/codesize.xml/ExcessiveParameterList" />
	<rule ref="rulesets/codesize.xml/ExcessivePublicCount" />
	<rule ref="rulesets/codesize.xml/TooManyFields" />
	<!-- NPathComplexity is not used: the cyclomatic complexity covers the same branching. -->
	<!-- TooManyMethods, TooManyPublicMethods: Embed and Providers are the public objects of the plugin; splitting them changes the API. -->

	<rule ref="rulesets/design.xml" />

	<rule ref="rulesets/naming.xml">
		<!-- Regex match arrays ($m), loop keys ($n) and the parameter $id are conventional names here. -->
		<exclude name="ShortVariable" />
		<!-- I18n::t() is the translation shorthand used in snippets. -->
		<exclude name="ShortMethodName" />
	</rule>

	<rule ref="rulesets/unusedcode.xml" />
</ruleset>
