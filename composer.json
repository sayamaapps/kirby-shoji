{
    "name": "sayamaapps/kirby-shoji",
    "description": "Kirby CMS plugin: YouTube, Vimeo, Digistore24 and forms load only after the visitor clicks.",
    "type": "kirby-plugin",
    "license": "MIT",
    "keywords": [
        "kirby",
        "kirby-plugin",
        "kirby-5",
        "privacy",
        "gdpr",
        "youtube",
        "vimeo",
        "click-to-load",
        "embed",
        "facade",
        "brevo",
        "forms"
    ],
    "homepage": "https://github.com/sayamaapps/kirby-shoji",
    "authors": [
        {
            "name": "Simon Räder",
            "homepage": "https://sayamaapps.de"
        }
    ],
    "support": {
        "issues": "https://github.com/sayamaapps/kirby-shoji/issues",
        "source": "https://github.com/sayamaapps/kirby-shoji"
    },
    "require": {
        "php": "^8.2",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "getkirby/cms": "^5.0",
        "phpunit/phpunit": "11.5.55"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "installer-name": "shoji",
        "kirby-cms-path": false,
        "kirby": {
            "compatible": "^5.0"
        }
    }
}
