{
    "name": "sayamaapps/kirby-shoji",
    "description": "Click-to-load for Kirby CMS: YouTube, Vimeo, Digistore24 and HTML forms (Brevo) stay behind a placeholder with a preview image from your own server until the visitor clicks. No third-party host in the page, no cookies, no inline script.",
    "type": "kirby-plugin",
    "license": "MIT",
    "keywords": ["kirby", "kirby-plugin", "kirby-5", "privacy", "gdpr", "youtube", "vimeo", "click-to-load", "embed", "facade", "brevo", "forms"],
    "homepage": "https://github.com/simsimmal/kirby-shoji",
    "authors": [
        {
            "name": "Simon Räder",
            "homepage": "https://sayamaapps.de"
        }
    ],
    "support": {
        "issues": "https://github.com/simsimmal/kirby-shoji/issues",
        "source": "https://github.com/simsimmal/kirby-shoji"
    },
    "require": {
        "php": "^8.2",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "getkirby/cms": "^5.0"
    },
    "scripts": {
        "test": "sh tests/run.sh"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "installer-name": "shoji",
        "kirby-cms-path": false,
        "kirby": {
            "compatible": "^5.0"
        }
    }
}
